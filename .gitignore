# =====================================================================
#  China PV-wind CMIP6/ERA5 project — conservative .gitignore
#  Full allow/deny list and rationale: docs/public_release_file_manifest.md
# =====================================================================

# ---- Bulk scientific data (NOT redistributable in the repo) ----------
# Raw CMIP6/ERA5, intermediate, and processed NetCDF (~60.7 GiB).
# These must be re-obtained from the sources and regenerated by the
# pipeline; see the README "Data availability" section.
data/
archive/

# ---- Papers / references (copyright-restricted) -----------------------
references/

# ---- GRIB / ERA5 raw and sidecars (also covered by data/, kept as
#      belt-and-braces for any copy outside data/) ----------------------
*.grib
*.grib2
*.idx

# ---- Intermediate figure data (regenerable) ---------------------------
# Only the final-analysis products (results/figure_data/final_analysis/)
# are tracked. The multimodel-ensemble maps/CSVs are an intermediate
# stage of build_multimodel_ensemble.py -> build_final_analysis_products.py.
results/figure_data/multimodel_ensemble/

# ---- Figure bundle zip (the 14 individual PNGs are tracked) -----------
results/figures/**/*.zip

# ---- First-version large transition table (excluded by release plan) --
results/tables/combined_historical_future_transition.csv

# ---- Generated results that embed the local absolute path -------------
# These files hard-code the local absolute path (and, in the
# dry-run logs, the username). They are all regenerable; keep them out
# of version control rather than publishing machine-specific paths.
# See docs/public_release_file_manifest.md §Privacy for details.
results/manifests/
results/figure_data/final_analysis/final_analysis_manifest.json
results/audits/qm_qdm_batch_logs/
results/audits/energy_production_audit/
results/audits/qm_qdm_production_audit/
results/audits/qm_distribution_diagnostics_17models/
results/audits/audit_report.txt
results/audits/audit_summary.json
results/audits/cmip6_prepare_target_periods_report.csv
results/audits/csv_inventory.csv
results/audits/netcdf_inventory.csv
results/audits/manifest_inventory.csv
results/audits/energy_production_audit_summary.json

# ---- One-off migration artifacts (embed the local path) ---------------
_reorganize.py
_refactor_paths.py
reorganization_manifest.json

# ---- Hand-written audit/report docs that embed the local interpreter
#      path and username (kept local-only, not modified in place; their
#      key findings are summarised in README.md).
docs/post_reorganization_audit.md
docs/github_release_readiness_audit.md
docs/path_refactoring_report.md

# ---- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
build/
dist/

# ---- Local environment / virtualenv -----------------------------------
.env
.venv/
venv/
.conda/
.python-version

# ---- Logs, temp files, IDE / OS ---------------------------------------
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db
.idea/
.vscode/
.pytest_cache/
.mypy_cache/
